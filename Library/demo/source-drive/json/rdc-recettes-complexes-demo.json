        "contenu": {
          "seo": {
            "titre": "Riz au lait à la banane",
            "description": "Un riz au lait doux et anti-gaspi, enrichi avec de la banane bien mûre pour sucrer naturellement et obtenir une texture plus onctueuse.",
            "mots_cles": [
              "riz-au-lait-a-la-banane",
