          "contenu": {
            "titre": "Gratin de pâtes au thon",
            "accroche": "Un gratin familial de pâtes au thon, crémeux et légèrement gratiné, pensé pour utiliser une boîte de thon, un reste de pâtes ou un fond de sauce tomate.",
            "introduction": "Cette version mise sur des pâtes cuites al dente, une base tomate ou crème bien assaisonnée et un passage au four juste assez long pour gratiner sans dessécher. C’est une recette économique, pratique et très adaptable."
          },
          "preparation": {
            "etapes": [
              "Préchauffer le four à 200 °C. Cuire les pâtes dans une grande casserole d’eau salée en les gardant al dente, puis les égoutter.",
              "Pendant la cuisson des pâtes, faire revenir l’oignon émincé dans un peu d’huile. Ajouter la sauce tomate ou la crème, le thon égoutté et émietté, puis poivrer et ajouter des herbes si disponibles.",
              "Mélanger les pâtes avec la sauce au thon. Ajouter un peu d’eau de cuisson, de lait ou de crème si le mélange paraît trop sec.",
              "Verser dans un plat à gratin. Répartir le fromage râpé sur le dessus.",
              "Enfourner 15 à 20 minutes, jusqu’à ce que le dessus soit doré. Laisser reposer 5 minutes avant de servir."
            ],
            "cuisson_indicative": {
              "texte": "Four : 200 °C pendant 15 à 20 min, après précuisson des pâtes à la casserole."
            }
          },
          "conseils": {
            "astuce_anti_gaspi": "Très bon avec un reste de pâtes déjà cuites : raccourcir le passage au four et ajouter un peu de lait ou de sauce pour éviter que le gratin soit sec.",
            "variantes": "Ajouter tomates en dés, maïs, petits pois, olives, restes de courgettes ou champignons. Remplacer la tomate par de la crème pour une version plus douce. Ajouter chapelure ou pain rassis mixé sur le dessus pour un gratin plus croustillant."
          },
          "conservation": {
            "texte": "À conserver 24 h au réfrigérateur dans une boîte fermée.",
            "rechauffage": "À réchauffer doucement si nécessaire.",
            "congelation": "À vérifier selon la recette."
          }
        },
