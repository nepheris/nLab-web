{
  "schema": "nlab-pdf-stamps/v4",
  "dateFormats": {
    "STAMP": "DD/MM/YYYY",
    "A": "DD/MM/YYYY",
    "B": "D MMMM YYYY",
    "C": "YYYY-MM-DD",
    "D": "DD/MM/YYYY"
  },
  "variables": [
    "{INITIALS}",
    "{FILENAME}",
    "{STAMP_DATE}",
    "{STAMP_DATE_FMT}",
    "{DATE_A}",
    "{DATE_B}",
    "{DATE_C}",
    "{DATE_D}",
    "{DATE_A_FMT}",
    "{DATE_B_FMT}",
    "{DATE_C_FMT}",
    "{DATE_D_FMT}",
    "{STAMP_DATE:YYYYMMDD}",
    "{DATE_B|D MMMM YYYY}",
    "{DATE_D:YYYYMMDD}"
  ],
  "stamps": [
    {
      "id": "affiche-date-a",
      "label": "AFFICHÉ - initiales - Date A",
      "template": "AFFICHÉ - {INITIALS}\nLe {DATE_A_FMT}",
      "prefix": "",
      "suffix": "_AF",
      "textPrefix": "",
      "textSuffix": ""
    },
    {
      "id": "affiche-jusqua-b",
      "label": "AFFICHÉ jusqu'au - Date B",
      "template": "AFFICHÉ - {INITIALS}\nÀ afficher jusqu’au {DATE_B_FMT}",
      "prefix": "",
      "suffix": "_AF",
      "textPrefix": "",
      "textSuffix": ""
    },
    {
      "id": "non-concerne",
      "label": "Non concerné",
      "template": "NC_{INITIALS}",
      "prefix": "",
      "suffix": "_NC",
      "textPrefix": "",
      "textSuffix": ""
    },
    {
      "id": "non-conforme",
      "label": "Non conforme",
      "template": "NON CONFORME - {INITIALS}",
      "prefix": "",
      "suffix": "_NCF",
      "textPrefix": "",
      "textSuffix": ""
    },
    {
      "id": "validation-abc",
      "label": "Validation A/B/C",
      "template": "VALIDÉ - {INITIALS}\nA : {DATE_A_FMT}\nB : {DATE_B_FMT}\nC : {DATE_C_FMT}",
      "prefix": "VAL_",
      "suffix": "",
      "textPrefix": "",
      "textSuffix": ""
    },
    {
      "id": "validation-duree-bc-reeval-d",
      "label": "Validation / validité B-C / réévaluation D",
      "template": "VALIDÉ - {INITIALS}\\nLe {STAMP_DATE_FMT}\\nValable du {DATE_B_FMT} au {DATE_C_FMT}\\nÀ réévaluer le {DATE_D_FMT}",
      "prefix": "VALIDE_{STAMP_DATE:YYYYMMDD}_",
      "suffix": "_REV_{DATE_D:YYYYMMDD}",
      "prefixEnabled": true,
      "suffixEnabled": true,
      "textPrefix": "",
      "textSuffix": ""
    }
  ]
}
