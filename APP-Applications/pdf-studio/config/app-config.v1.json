{
  "schema": "nlab.pdfstudio.app-config/v1",
  "app": {
    "id": "APP07",
    "product": "nLab Scan Studio",
    "module": "PDF Studio",
    "version": "0.9.19",
    "channel": "test"
  },
  "auth": {
    "google": {
      "enabled": true,
      "clientId": "",
      "prompt": "select_account",
      "scopes": [
        "openid",
        "email",
        "profile",
        "https://www.googleapis.com/auth/drive.file"
      ]
    }
  },
  "storage": {
    "personalWorkspaceFile": "nlab-pdf-studio-workspace.json",
    "driveRoot": "nLab",
    "driveFolder": "PDF Studio",
    "subfolders": [
      "Signatures",
      "Documents",
      "Exports"
    ],
    "legacyAppData": "migration-only",
    "personalWorkspaceSync": "debounced-auto-when-connected"
  },
  "variables": {
    "syntax": "{VARIABLE} or {VARIABLE:FORMAT}",
    "dateFormatTokens": [
      "YYYY",
      "YY",
      "MMMM",
      "MMM",
      "MM",
      "M",
      "DD",
      "D",
      "HH",
      "H",
      "mm",
      "m",
      "ss",
      "s",
      "SSS",
      "Z",
      "ZZ",
      "X",
      "x"
    ],
    "formats": {
      "NOW": "YYYY-MM-DD HH:mm:ss",
      "DATE": "YYYY-MM-DD",
      "TIME": "HH:mm:ss",
      "DATETIME": "YYYY-MM-DD HH:mm:ss",
      "TIMESTAMP": "YYYYMMDD_HHmmss",
      "STAMP_DATE": "DD/MM/YYYY",
      "STAMP_DATETIME": "DD/MM/YYYY HH:mm:ss",
      "DATE_A": "DD/MM/YYYY",
      "DATE_B": "DD/MM/YYYY",
      "DATE_C": "DD/MM/YYYY",
      "DATE_D": "DD/MM/YYYY"
    },
    "legacyAliases": {
      "STAMP_DATE_FMT": "STAMP_DATE",
      "DATE_A_FMT": "DATE_A",
      "DATE_B_FMT": "DATE_B",
      "DATE_C_FMT": "DATE_C",
      "DATE_D_FMT": "DATE_D"
    }
  },
  "stamps": {
    "dateSlots": [
      {
        "key": "STAMP_DATE",
        "label": "Date du tampon"
      },
      {
        "key": "DATE_A",
        "label": "Date A"
      },
      {
        "key": "DATE_B",
        "label": "Date B"
      },
      {
        "key": "DATE_C",
        "label": "Date C"
      },
      {
        "key": "DATE_D",
        "label": "Date D"
      }
    ],
    "personalizable": true,
    "filenameRulesUseCanonicalVariables": true,
    "library": [
      {
        "id": "date",
        "category": "Date & heure",
        "label": "DATE",
        "template": "DATE - {STAMP_DATE}"
      },
      {
        "id": "datetime",
        "category": "Date & heure",
        "label": "HORODATAGE",
        "template": "HORODATAGE - {STAMP_DATE:DD/MM/YYYY} {NOW:HH:mm:ss}"
      },
      {
        "id": "initials",
        "category": "Initiales",
        "label": "INITIALES",
        "template": "{INITIALS}"
      },
      {
        "id": "nonconforme-initials",
        "category": "Initiales",
        "label": "NON CONFORME · INITIALES",
        "template": "NON CONFORME - {INITIALS}"
      },
      {
        "id": "nc-initials",
        "category": "Initiales",
        "label": "NON CONCERNÉ · INITIALES",
        "template": "NC_{INITIALS}"
      },
      {
        "id": "vu",
        "category": "Statut",
        "label": "VU",
        "template": "VU - {INITIALS} - {STAMP_DATE}"
      },
      {
        "id": "nc",
        "category": "Statut",
        "label": "NON CONCERNÉ",
        "template": "NC_{INITIALS}_{STAMP_DATE:YYYYMMDD}"
      },
      {
        "id": "affiche",
        "category": "Statut",
        "label": "AFFICHÉ",
        "template": "AFFICHE_{INITIALS}_{STAMP_DATE:YYYYMMDD}"
      },
      {
        "id": "traite",
        "category": "Statut",
        "label": "TRAITÉ",
        "template": "TRAITE - {INITIALS} - {STAMP_DATE}"
      },
      {
        "id": "valide",
        "category": "Validation",
        "label": "VALIDÉ",
        "template": "VALIDE - {INITIALS} - {STAMP_DATE}"
      },
      {
        "id": "filename",
        "category": "Document",
        "label": "FICHIER + DATE",
        "template": "{FILENAME} - {STAMP_DATE}"
      }
    ]
  },
  "workspaceDefaults": {
    "variables": {
      "formats": {
        "NOW": "YYYY-MM-DD HH:mm:ss",
        "DATE": "YYYY-MM-DD",
        "TIME": "HH:mm:ss",
        "DATETIME": "YYYY-MM-DD HH:mm:ss",
        "TIMESTAMP": "YYYYMMDD_HHmmss",
        "STAMP_DATE": "DD/MM/YYYY",
        "STAMP_DATETIME": "DD/MM/YYYY HH:mm:ss",
        "DATE_A": "DD/MM/YYYY",
        "DATE_B": "DD/MM/YYYY",
        "DATE_C": "DD/MM/YYYY",
        "DATE_D": "DD/MM/YYYY"
      }
    },
    "output": {
      "drive": {
        "autoUploadExports": false
      }
    }
  }
}
