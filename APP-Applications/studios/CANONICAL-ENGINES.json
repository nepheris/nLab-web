  "promotionRule": {
    "twoOrMoreConsumers": "promote to Studio Core or an upstream BRK; Studios keep orchestration/UI only",
    "domainSpecific": "may remain in the domain Studio engine when reuse outside the domain is not justified",
    "derivedApps": "must call parent Studio engine; never fork processing logic"
  }
