{
  "schema": "nlab-canonical-engines/v1",
  "updated": "2026-10-04",
  "rule": "Before creating a Studio-local processing function, search this registry, Studio Core, upstream BRK and Web Framework capabilities. A capability shared by two or more Studios must have one canonical engine.",
